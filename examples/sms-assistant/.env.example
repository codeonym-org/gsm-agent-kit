# Copy to the workspace root as .env; local secrets/data are ignored by Git.
GSM_DEVICE__ADAPTER=zte-mf833t
GSM_DEVICE__ID=zte-device
GSM_DEVICE__ZTE_MF833T__BASE_URL=http://192.168.0.1
GSM_DEVICE__ZTE_MF833T__STORAGE_GENERATION=initial
GSM_DEVICE__ZTE_MF833T__SUBSCRIPTION_GENERATION=initial

GSM_INBOX__ENABLED=true
GSM_INBOX__DATABASE_PATH=data/inbox.sqlite3
GSM_SUBMISSIONS__ENABLED=false
GSM_SUBMISSIONS__DATABASE_PATH=data/submissions.sqlite3
GSM_SUBMISSIONS__MAX_TOTAL_CHARS=240
GSM_SUBMISSIONS__MAX_PARTS=3

# Enable after setting the OpenRouter key. Dry-run still calls the model.
GSM_ASSISTANT__ENABLED=false
GSM_ASSISTANT__DRY_RUN=true
# GSM_ASSISTANT__API_KEY=your-openrouter-key
GSM_ASSISTANT__MODEL=openai/gpt-4.1-mini
GSM_ASSISTANT__INSTRUCTIONS="You are a helpful general SMS assistant. Reply in the sender's language."
GSM_ASSISTANT__DATABASE_PATH=data/conversations.sqlite3
GSM_ASSISTANT__MAX_OUTPUT_TOKENS=384
GSM_ASSISTANT__TIMEOUT_SECONDS=60
GSM_ASSISTANT__POLL_INTERVAL_SECONDS=2
# Set explicitly to allow national sender numbers; otherwise international only.
# GSM_ASSISTANT__DEFAULT_REGION=MA
GSM_ASSISTANT__HISTORY_MAX_MESSAGES=20
GSM_ASSISTANT__HISTORY_MAX_CHARS=6000
GSM_ASSISTANT__HISTORY_RETENTION_DAYS=30
GSM_ASSISTANT__INPUT_MAX_CHARS=2000
# GSM_API_TOKEN=your-local-api-token
