# Local management API of the inspected inwi ZTE MF833T.
GSM_MODEM__URL=http://192.168.0.1
# Inwi's balance consultation code; configurable for your SIM/offer.
GSM_MODEM__BALANCE_CODE="*120*30#"
GSM_MODEM__USSD_TIMEOUT=30
GSM_STORAGE__PATH=data/inbox.sqlite3
GSM_LISTENER__ENABLED=true
GSM_LISTENER__POLL_INTERVAL=3
# Enable AI processing, inspect dry_run records, then enable physical sending.
GSM_LISTENER__AUTO_REPLY=false
GSM_LISTENER__DRY_RUN=true
GSM_AGENT__MODEL=openai/gpt-4.1-mini
# Hard limits after plain-text normalization; SMS count also counts part labels.
GSM_AGENT__MAX_REPLY_CHARS=240
GSM_AGENT__MAX_SMS_PARTS=3
# Per model completion, including structured JSON overhead.
GSM_AGENT__MAX_OUTPUT_TOKENS=384
# Durable memory by normalized sender phone number, bounded in each model prompt.
GSM_AGENT__HISTORY_MESSAGES=20
GSM_AGENT__HISTORY_CHARS=6000
# Set your OpenRouter key here or export OPENROUTER_API_KEY before starting.
GSM_AGENT__API_KEY=
# Optional OpenRouter base URL override and custom system instructions:
# GSM_AGENT__BASE_URL=https://openrouter.ai/api/v1
# GSM_AGENT__INSTRUCTIONS=Your SMS assistant instructions
# Recommended when exposing the API beyond localhost:
# GSM_API_TOKEN=replace-with-a-random-token
GSM_TRACE_CONSOLE=false
